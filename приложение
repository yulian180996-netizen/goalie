<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>Вратарь · Спартак</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<style>
  :root{ --red:#D6112E; --ink:#15181D; --card:#1C2027; --line:#2C313B;
         --tx:#EDEFF2; --tx2:#98A0AA; --ok:#2FA84F; }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  body{margin:0;background:var(--ink);color:var(--tx);
       font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;font-size:15px;padding-bottom:76px}
  .wrap{padding:14px 14px 0}
  h1{font-size:19px;margin:0 0 2px}
  .sub{color:var(--tx2);font-size:13px;margin-bottom:14px}
  .card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px;margin-bottom:12px}
  .card h2{font-size:15px;margin:0 0 10px;display:flex;align-items:center;gap:8px}
  .card h2:before{content:'';width:4px;height:15px;background:var(--red);border-radius:2px}
  label{display:block;font-size:13px;color:var(--tx2);margin:12px 0 6px}
  input,textarea,select{width:100%;background:#12161C;border:1px solid var(--line);color:var(--tx);
       border-radius:10px;padding:11px;font-size:15px;font-family:inherit}
  textarea{min-height:64px;resize:vertical}
  .scale{display:flex;gap:6px;flex-wrap:wrap}
  .scale button{flex:1;min-width:36px;background:#12161C;border:1px solid var(--line);color:var(--tx2);
       border-radius:9px;padding:9px 0;font-size:14px;cursor:pointer}
  .scale button.on{background:var(--red);border-color:var(--red);color:#fff;font-weight:700}
  .btn{width:100%;background:var(--red);color:#fff;border:0;border-radius:11px;padding:14px;
       font-size:15px;font-weight:700;cursor:pointer;margin-top:14px}
  .btn.sec{background:#252A33;color:var(--tx)}
  .row{display:flex;gap:10px}
  .row>*{flex:1}
  .stat{display:flex;gap:8px;margin-bottom:10px}
  .stat div{flex:1;background:#12161C;border:1px solid var(--line);border-radius:11px;padding:10px;text-align:center}
  .stat b{display:block;font-size:20px;color:#fff}
  .stat span{font-size:11px;color:var(--tx2)}
  .bars{display:flex;align-items:flex-end;gap:3px;height:64px;margin-top:8px}
  .bars i{flex:1;background:var(--red);border-radius:3px 3px 0 0;opacity:.85;min-height:2px}
  .list{font-size:13px}
  .list div{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--line);color:var(--tx2)}
  .list div:last-child{border:0}
  .list b{color:var(--tx);font-weight:600}
  nav{position:fixed;left:0;right:0;bottom:0;background:#101419;border-top:1px solid var(--line);
      display:flex;padding:6px 4px calc(6px + env(safe-area-inset-bottom))}
  nav button{flex:1;background:0;border:0;color:var(--tx2);font-size:10.5px;padding:7px 2px;cursor:pointer}
  nav button.on{color:var(--red);font-weight:700}
  nav span{display:block;font-size:19px;line-height:1.15}
  .hide{display:none}
  /* Шульте */
  #grid{display:grid;grid-template-columns:repeat(6,1fr);gap:6px;margin-top:10px}
  #grid button{aspect-ratio:1;background:#12161C;border:1px solid var(--line);color:var(--tx);
       border-radius:9px;font-size:16px;font-weight:600;cursor:pointer}
  #grid button.done{background:#1E2A20;color:#3E8F55;border-color:#26402C}
  #grid button.bad{background:#3A1A1F;border-color:#5A2029}
  .big{font-size:30px;font-weight:800;text-align:center;margin:6px 0}
  .goal{background:#12161C;border:1px solid var(--line);border-radius:11px;padding:11px;margin-bottom:8px}
  .goal .t{font-size:14px;margin-bottom:4px}
  .goal .c{font-size:12px;color:var(--tx2)}
  .goal .x{float:right;color:var(--tx2);cursor:pointer;font-size:18px;line-height:1}
  .tag{display:inline-block;font-size:11px;background:#2A1116;color:#E2606F;border-radius:6px;padding:2px 7px;margin-bottom:6px}
  .done-tag{background:#16281B;color:#4FA765}
  .ok{color:var(--ok)}
</style>
</head>
<body>

<div class="wrap">
  <!-- ГЛАВНАЯ -->
  <section id="p-home">
    <h1 id="hello">Привет!</h1>
    <div class="sub" id="today"></div>
    <div class="card">
      <h2>Сегодня</h2>
      <div class="stat">
        <div><b id="h-sleep">—</b><span>сон, ч</span></div>
        <div><b id="h-mood">—</b><span>настрой</span></div>
        <div><b id="h-sch">—</b><span>Шульте, с</span></div>
      </div>
      <div id="h-status" class="sub" style="margin:0"></div>
      <button class="btn" data-act="go:wb">Заполнить самочувствие</button>
      <button class="btn sec" data-act="go:sch">Тренировать внимание</button>
    </div>
    <div class="card">
      <h2>Цель на сезон</h2>
      <div id="h-goal" class="sub" style="margin:0">Пока не заполнена — открой раздел «Цели».</div>
    </div>
    <div class="card">
      <h2>Отчёт тренеру</h2>
      <div class="sub" style="margin:0">Сводка за 7 дней: сон, настрой, усталость, внимание.</div>
      <button class="btn sec" data-act="report">Собрать и скопировать</button>
    </div>
  </section>

  <!-- САМОЧУВСТВИЕ -->
  <section id="p-wb" class="hide">
    <h1>Дневник самочувствия</h1>
    <div class="sub">Заполняй утром — за минуту.</div>
    <div class="card">
      <h2>Запись на сегодня</h2>
      <label>Сон, часов</label>
      <div class="scale" id="s-sleep"></div>
      <label>Качество сна (1–5)</label>
      <div class="scale" id="s-quality"></div>
      <label>Усталость (1–10, больше — сильнее устал)</label>
      <div class="scale" id="s-fatigue"></div>
      <label>Настрой (1–10)</label>
      <div class="scale" id="s-mood"></div>
      <div class="row">
        <div><label>Пульс покоя</label><input id="i-pulse" type="number" inputmode="numeric" placeholder="уд/мин"></div>
        <div><label>Вес, кг</label><input id="i-weight" type="number" inputmode="decimal" placeholder="кг"></div>
      </div>
      <label>Комментарий</label>
      <textarea id="i-note" placeholder="Что чувствуешь, что болит, что мешает"></textarea>
      <button class="btn" data-act="wbsave">Сохранить</button>
    </div>
    <div class="card">
      <h2>Динамика настроя</h2>
      <div class="bars" id="wb-bars"></div>
      <div class="sub" style="margin:8px 0 0" id="wb-avg"></div>
    </div>
    <div class="card">
      <h2>История</h2>
      <div class="list" id="wb-list"></div>
    </div>
  </section>

  <!-- ЦЕЛИ -->
  <section id="p-goals" class="hide">
    <h1>Цели</h1>
    <div class="sub">Сезон → месяц → тренировка.</div>
    <div class="card">
      <h2>Цель на сезон</h2>
      <label>Что хочу сделать</label>
      <input id="g-season" placeholder="Например: закрепиться в основе">
      <label>Критерий — как пойму, что достиг</label>
      <input id="g-season-c" placeholder="Например: 90% отражённых за сезон">
      <button class="btn" data-act="season">Сохранить</button>
    </div>
    <div class="card">
      <h2>Цель на месяц</h2>
      <label>Что делаю в этом месяце</label>
      <input id="g-month" placeholder="Например: контроль отскоков">
      <label>Критерий</label>
      <input id="g-month-c" placeholder="Например: не больше 1 добивания за игру">
      <button class="btn" data-act="month">Сохранить</button>
      <div id="g-month-list" style="margin-top:12px"></div>
    </div>
    <div class="card">
      <h2>Цель на тренировку или матч</h2>
      <label>Что отрабатываю сегодня</label>
      <input id="g-day" placeholder="Например: игра клюшкой за воротами">
      <button class="btn" data-act="dayadd">Добавить</button>
      <div id="g-day-list" style="margin-top:12px"></div>
    </div>
  </section>

  <!-- ШУЛЬТЕ -->
  <section id="p-sch" class="hide">
    <h1>Таблица Шульте 6×6</h1>
    <div class="sub">Найди числа от 1 до 36 по порядку. Смотри в центр.</div>
    <div class="card">
      <div class="big"><span id="timer">0.0</span> с</div>
      <div class="sub" style="text-align:center;margin:0">
        Ищем: <b id="next-num" style="color:#fff">1</b> · ошибок: <b id="errs" style="color:#fff">0</b>
      </div>
      <div id="grid"></div>
      <button class="btn" data-act="schstart">Новая попытка</button>
    </div>
    <div class="card">
      <h2>Результаты</h2>
      <div class="stat">
        <div><b id="sch-best">—</b><span>лучший</span></div>
        <div><b id="sch-avg">—</b><span>средний 7 дн.</span></div>
        <div><b id="sch-cnt">0</b><span>попыток</span></div>
      </div>
      <div class="bars" id="sch-bars"></div>
      <div class="list" id="sch-list" style="margin-top:10px"></div>
    </div>
  </section>

  <!-- ПРОФИЛЬ -->
  <section id="p-me" class="hide">
    <h1>Профиль</h1>
    <div class="sub">Данные хранятся в твоём Telegram.</div>
    <div class="card">
      <h2>Вратарь</h2>
      <label>Имя и фамилия</label><input id="m-name" placeholder="Иванов Юрий">
      <label>Команда</label><input id="m-team" placeholder="Спартак-МАХ">
      <label>Год рождения</label><input id="m-year" type="number" inputmode="numeric" placeholder="2008">
      <button class="btn" data-act="mesave">Сохранить</button>
    </div>
    <div class="card">
      <h2>Данные</h2>
      <div class="sub" style="margin:0">Экспорт — на случай смены телефона или чтобы отправить тренеру.</div>
      <button class="btn sec" data-act="export">Скопировать все данные</button>
      <div class="sub" id="diag" style="margin:12px 0 0;font-size:11px"></div>
    </div>
  </section>
</div>

<nav>
  <button id="n-home" class="on" data-act="go:home"><span>◆</span>Главная</button>
  <button id="n-wb" data-act="go:wb"><span>☾</span>Самочувствие</button>
  <button id="n-goals" data-act="go:goals"><span>◎</span>Цели</button>
  <button id="n-sch" data-act="go:sch"><span>⊞</span>Шульте</button>
  <button id="n-me" data-act="go:me"><span>☺</span>Профиль</button>
</nav>

<script>
var TG = (window.Telegram && window.Telegram.WebApp) ? window.Telegram.WebApp : null;
if (TG) { TG.ready(); TG.expand(); try { TG.setHeaderColor('#15181D'); TG.setBackgroundColor('#15181D'); } catch(e){} }
var CS = null;
try { if (TG && TG.CloudStorage && TG.isVersionAtLeast && TG.isVersionAtLeast('6.9')) CS = TG.CloudStorage; } catch(e){}

/* ---------- хранилище ---------- */
function load(key, cb){
  if (CS) { CS.getItem(key, function(err, val){ cb(parse(val)); }); }
  else { cb(parse(localStorage.getItem('gk_' + key))); }
}
function save(key, obj, cb){
  var s = JSON.stringify(obj);
  if (CS) { CS.setItem(key, s, function(){ if(cb) cb(); }); }
  else { localStorage.setItem('gk_' + key, s); if(cb) cb(); }
}
function parse(v){ if(!v) return null; try { return JSON.parse(v); } catch(e){ return null; } }
function haptic(t){ try { if(TG && TG.HapticFeedback) TG.HapticFeedback.impactOccurred(t || 'light'); } catch(e){} }
function alertMsg(m){ if (TG && TG.showPopup) { try { TG.showPopup({message:m}); return; } catch(e){} } alert(m); }

/* ---------- состояние ---------- */
var DB = { wb: [], goals: { season:null, months:{}, days:[] }, schulte: [], me: {} };
var today = new Date().toISOString().slice(0,10);
var curMonth = today.slice(0,7);

function boot(){
  load('wb', function(v){ DB.wb = v || [];
  load('goals', function(g){ DB.goals = g || { season:null, months:{}, days:[] };
  load('schulte', function(s){ DB.schulte = s || [];
  load('me', function(m){ DB.me = m || {}; render(); }); }); }); });
}

/* ---------- навигация ---------- */
function go(page){
  var pages = ['home','wb','goals','sch','me'];
  for (var i=0;i<pages.length;i++){
    document.getElementById('p-' + pages[i]).className = (pages[i]===page) ? '' : 'hide';
    document.getElementById('n-' + pages[i]).className = (pages[i]===page) ? 'on' : '';
  }
  window.scrollTo(0,0);
  if (page==='sch' && !running) buildGrid(true);
}

/* ---------- шкалы ---------- */
var pick = { sleep:null, quality:null, fatigue:null, mood:null };
function buildScale(id, key, from, to, step){
  var host = document.getElementById(id), html = '';
  for (var v=from; v<=to; v += step){
    var lbl = (step<1) ? v.toFixed(1) : String(v);
    html += '<button data-act="pick:' + key + ':' + v + '">' + lbl + '</button>';
  }
  host.innerHTML = html;
}
function setPick(key, val, el){
  pick[key] = val; haptic();
  var kids = el.parentNode.children;
  for (var i=0;i<kids.length;i++) kids[i].className = '';
  el.className = 'on';
}
/* единый обработчик нажатий — работает в любой песочнице */
document.addEventListener('click', function(ev){
  var el = ev.target;
  while (el && el.getAttribute && !el.getAttribute('data-act') && el !== document.body) el = el.parentNode;
  if (!el || !el.getAttribute) return;
  var act = el.getAttribute('data-act');
  if (!act) return;
  var a = act.split(':');
  try {
    if (a[0] === 'go') go(a[1]);
    else if (a[0] === 'pick') setPick(a[1], parseFloat(a[2]), el);
    else if (a[0] === 'hit') hit(parseInt(a[1], 10));
    else if (a[0] === 'schstart') startSchulte();
    else if (a[0] === 'wbsave') saveWB();
    else if (a[0] === 'season') saveSeason();
    else if (a[0] === 'month') saveMonth();
    else if (a[0] === 'dayadd') addDay();
    else if (a[0] === 'daytog') toggleDay(parseInt(a[1], 10));
    else if (a[0] === 'daydel') delDay(parseInt(a[1], 10));
    else if (a[0] === 'mesave') saveMe();
    else if (a[0] === 'report') report();
    else if (a[0] === 'export') exportAll();
  } catch(e){ alertMsg('Ошибка: ' + e.message); }
});

/* ---------- самочувствие ---------- */
function saveWB(){
  if (pick.sleep===null || pick.mood===null){ alertMsg('Отметь хотя бы сон и настрой.'); return; }
  var rec = { d: today, s: pick.sleep, q: pick.quality, f: pick.fatigue, m: pick.mood,
              p: num(document.getElementById('i-pulse').value),
              w: num(document.getElementById('i-weight').value),
              c: (document.getElementById('i-note').value || '').slice(0,90) };
  DB.wb = DB.wb.filter(function(x){ return x.d !== today; });
  DB.wb.push(rec);
  DB.wb.sort(function(a,b){ return a.d < b.d ? 1 : -1; });
  DB.wb = DB.wb.slice(0,60);
  save('wb', DB.wb, function(){ haptic('medium'); alertMsg('Сохранено. Так держать!'); render(); });
}
function num(v){ var n = parseFloat(String(v).replace(',','.')); return isNaN(n) ? null : n; }

/* ---------- цели ---------- */
function saveSeason(){
  var t = document.getElementById('g-season').value.trim();
  if(!t){ alertMsg('Впиши цель.'); return; }
  DB.goals.season = { t: t, c: document.getElementById('g-season-c').value.trim() };
  save('goals', DB.goals, function(){ alertMsg('Цель на сезон сохранена.'); render(); });
}
function saveMonth(){
  var t = document.getElementById('g-month').value.trim();
  if(!t){ alertMsg('Впиши цель на месяц.'); return; }
  DB.goals.months[curMonth] = { t: t, c: document.getElementById('g-month-c').value.trim() };
  save('goals', DB.goals, function(){ alertMsg('Цель на месяц сохранена.'); render(); });
}
function addDay(){
  var t = document.getElementById('g-day').value.trim();
  if(!t){ alertMsg('Впиши цель на занятие.'); return; }
  DB.goals.days.unshift({ d: today, t: t, ok: false });
  DB.goals.days = DB.goals.days.slice(0,40);
  document.getElementById('g-day').value = '';
  save('goals', DB.goals, function(){ haptic(); render(); });
}
function toggleDay(i){
  DB.goals.days[i].ok = !DB.goals.days[i].ok;
  save('goals', DB.goals, function(){ haptic(); render(); });
}
function delDay(i){
  DB.goals.days.splice(i,1);
  save('goals', DB.goals, function(){ render(); });
}

/* ---------- Шульте ---------- */
var order = [], next = 1, errs = 0, t0 = 0, tick = null, running = false;
function buildGrid(preview){
  var nums = [];
  for (var i=1;i<=36;i++) nums.push(i);
  for (var j=nums.length-1;j>0;j--){ var k = Math.floor(Math.random()*(j+1)); var tmp=nums[j]; nums[j]=nums[k]; nums[k]=tmp; }
  order = nums;
  var html = '';
  for (var q=0;q<36;q++) html += '<button id="c' + q + '" data-act="hit:' + q + '">' + nums[q] + '</button>';
  document.getElementById('grid').innerHTML = html;
  next = 1; errs = 0; running = !preview;
  document.getElementById('next-num').textContent = '1';
  document.getElementById('errs').textContent = '0';
  document.getElementById('timer').textContent = '0.0';
}
function startSchulte(){
  buildGrid(false);
  t0 = Date.now(); running = true;
  if (tick) clearInterval(tick);
  tick = setInterval(function(){
    document.getElementById('timer').textContent = ((Date.now()-t0)/1000).toFixed(1);
  }, 100);
}
function hit(idx){
  if (!running) { startSchulte(); return; }
  var btn = document.getElementById('c' + idx);
  if (order[idx] === next){
    btn.className = 'done'; haptic();
    next++;
    document.getElementById('next-num').textContent = String(Math.min(next,36));
    if (next > 36) finishSchulte();
  } else {
    errs++; document.getElementById('errs').textContent = String(errs);
    btn.className = 'bad'; haptic('heavy');
    setTimeout(function(){ if (btn.className === 'bad') btn.className = ''; }, 220);
  }
}
function finishSchulte(){
  running = false; clearInterval(tick);
  var sec = Math.round((Date.now()-t0)/100)/10;
  DB.schulte.unshift({ d: today, t: sec, e: errs });
  DB.schulte = DB.schulte.slice(0,60);
  save('schulte', DB.schulte, function(){
    haptic('medium');
    var best = bestSchulte();
    alertMsg('Готово: ' + sec + ' с, ошибок ' + errs + (sec <= best ? '. Это твой лучший результат!' : ''));
    render();
  });
}
function bestSchulte(){
  if (!DB.schulte.length) return 999;
  return DB.schulte.reduce(function(a,x){ return Math.min(a, x.t); }, 999);
}

/* ---------- профиль и отчёт ---------- */
function saveMe(){
  DB.me = { n: document.getElementById('m-name').value.trim(),
            tm: document.getElementById('m-team').value.trim(),
            y: document.getElementById('m-year').value.trim() };
  save('me', DB.me, function(){ alertMsg('Сохранено.'); render(); });
}
function avg(arr){ if(!arr.length) return null; var s=0; for(var i=0;i<arr.length;i++) s+=arr[i]; return s/arr.length; }
function last7(){
  var lim = new Date(Date.now() - 7*864e5).toISOString().slice(0,10);
  return DB.wb.filter(function(x){ return x.d >= lim; });
}
function report(){
  var w = last7();
  var sch7 = DB.schulte.filter(function(x){ return x.d >= new Date(Date.now()-7*864e5).toISOString().slice(0,10); });
  var lines = [];
  lines.push('Отчёт вратаря' + (DB.me.n ? ': ' + DB.me.n : ''));
  lines.push('Период: последние 7 дней');
  lines.push('');
  if (w.length){
    lines.push('Сон: ' + fmt(avg(w.map(function(x){return x.s;}).filter(ok))) + ' ч');
    lines.push('Качество сна: ' + fmt(avg(w.map(function(x){return x.q;}).filter(ok))) + ' из 5');
    lines.push('Настрой: ' + fmt(avg(w.map(function(x){return x.m;}).filter(ok))) + ' из 10');
    lines.push('Усталость: ' + fmt(avg(w.map(function(x){return x.f;}).filter(ok))) + ' из 10');
    lines.push('Записей: ' + w.length + ' из 7');
  } else { lines.push('Дневник самочувствия за неделю не заполнялся.'); }
  lines.push('');
  if (sch7.length){
    lines.push('Шульте: лучший ' + Math.min.apply(null, sch7.map(function(x){return x.t;})) + ' с, ' +
               'средний ' + fmt(avg(sch7.map(function(x){return x.t;}))) + ' с, попыток ' + sch7.length);
  } else { lines.push('Шульте на этой неделе не тренировал.'); }
  if (DB.goals.season) { lines.push(''); lines.push('Цель сезона: ' + DB.goals.season.t); }
  if (DB.goals.months[curMonth]) lines.push('Цель месяца: ' + DB.goals.months[curMonth].t);
  var done = DB.goals.days.filter(function(x){ return x.ok; }).length;
  if (DB.goals.days.length) lines.push('Цели на занятия: выполнено ' + done + ' из ' + DB.goals.days.length);
  copy(lines.join('\n'), 'Отчёт скопирован — вставь его в чат тренеру.');
}
function ok(v){ return v !== null && v !== undefined; }
function fmt(v){ return (v === null || v === undefined) ? '—' : (Math.round(v*10)/10).toString().replace('.', ','); }
function exportAll(){ copy(JSON.stringify(DB), 'Все данные скопированы.'); }
function copy(text, msg){
  var ta = document.createElement('textarea');
  ta.value = text; ta.style.position='fixed'; ta.style.opacity='0';
  document.body.appendChild(ta); ta.select();
  try { document.execCommand('copy'); alertMsg(msg); } catch(e){ alertMsg(text); }
  document.body.removeChild(ta);
}

/* ---------- отрисовка ---------- */
function render(){
  var name = DB.me.n ? DB.me.n.split(' ')[0] : (TG && TG.initDataUnsafe && TG.initDataUnsafe.user ? TG.initDataUnsafe.user.first_name : '');
  document.getElementById('hello').textContent = name ? ('Привет, ' + name + '!') : 'Привет!';
  var dd = new Date();
  var mn = ['января','февраля','марта','апреля','мая','июня','июля','августа','сентября','октября','ноября','декабря'];
  document.getElementById('today').textContent = dd.getDate() + ' ' + mn[dd.getMonth()] + ', ' +
    ['воскресенье','понедельник','вторник','среда','четверг','пятница','суббота'][dd.getDay()];

  var wbToday = DB.wb.filter(function(x){ return x.d === today; })[0];
  document.getElementById('h-sleep').textContent = wbToday && ok(wbToday.s) ? String(wbToday.s) : '—';
  document.getElementById('h-mood').textContent  = wbToday && ok(wbToday.m) ? String(wbToday.m) : '—';
  var schToday = DB.schulte.filter(function(x){ return x.d === today; });
  document.getElementById('h-sch').textContent = schToday.length ? String(Math.min.apply(null, schToday.map(function(x){return x.t;}))) : '—';
  document.getElementById('h-status').innerHTML = wbToday
    ? '<span class="ok">Самочувствие на сегодня заполнено.</span>'
    : 'Самочувствие сегодня ещё не заполнено.';
  document.getElementById('h-goal').textContent = DB.goals.season
    ? DB.goals.season.t + (DB.goals.season.c ? ' · критерий: ' + DB.goals.season.c : '')
    : 'Пока не заполнена — открой раздел «Цели».';

  // самочувствие: график и список
  var series = DB.wb.slice(0,14).reverse();
  document.getElementById('wb-bars').innerHTML = series.map(function(x){
    var h = ok(x.m) ? Math.max(4, x.m*10) : 4;
    return '<i style="height:' + h + '%"></i>';
  }).join('');
  var a7 = last7();
  document.getElementById('wb-avg').textContent = a7.length
    ? 'За 7 дней: сон ' + fmt(avg(a7.map(function(x){return x.s;}).filter(ok))) + ' ч · настрой ' +
      fmt(avg(a7.map(function(x){return x.m;}).filter(ok))) + ' · усталость ' +
      fmt(avg(a7.map(function(x){return x.f;}).filter(ok)))
    : 'Пока нет записей за неделю.';
  document.getElementById('wb-list').innerHTML = DB.wb.slice(0,10).map(function(x){
    return '<div><span>' + x.d.slice(8,10) + '.' + x.d.slice(5,7) + '</span><b>сон ' +
      (ok(x.s)?x.s:'—') + ' ч · настрой ' + (ok(x.m)?x.m:'—') + ' · усталость ' + (ok(x.f)?x.f:'—') + '</b></div>';
  }).join('') || '<div>Записей пока нет.</div>';

  // цели
  if (DB.goals.season){
    document.getElementById('g-season').value = DB.goals.season.t;
    document.getElementById('g-season-c').value = DB.goals.season.c || '';
  }
  var gm = DB.goals.months[curMonth];
  if (gm){ document.getElementById('g-month').value = gm.t; document.getElementById('g-month-c').value = gm.c || ''; }
  var months = Object.keys(DB.goals.months).sort().reverse().slice(0,6);
  document.getElementById('g-month-list').innerHTML = months.map(function(k){
    return '<div class="goal"><div class="tag">' + k + '</div><div class="t">' + esc(DB.goals.months[k].t) + '</div>' +
      (DB.goals.months[k].c ? '<div class="c">' + esc(DB.goals.months[k].c) + '</div>' : '') + '</div>';
  }).join('');
  document.getElementById('g-day-list').innerHTML = DB.goals.days.slice(0,12).map(function(x,i){
    return '<div class="goal"><span class="x" data-act="daydel:' + i + '">×</span>' +
      '<div class="tag ' + (x.ok?'done-tag':'') + '" data-act="daytog:' + i + '">' +
      (x.ok ? 'выполнено' : 'отметить') + ' · ' + x.d.slice(8,10) + '.' + x.d.slice(5,7) + '</div>' +
      '<div class="t">' + esc(x.t) + '</div></div>';
  }).join('') || '<div class="sub" style="margin:0">Целей пока нет.</div>';

  // Шульте
  document.getElementById('sch-cnt').textContent = String(DB.schulte.length);
  document.getElementById('sch-best').textContent = DB.schulte.length ? String(bestSchulte()) : '—';
  var s7 = DB.schulte.slice(0,7).map(function(x){ return x.t; });
  document.getElementById('sch-avg').textContent = s7.length ? fmt(avg(s7)) : '—';
  var sser = DB.schulte.slice(0,14).reverse();
  var mx = sser.length ? Math.max.apply(null, sser.map(function(x){return x.t;})) : 1;
  document.getElementById('sch-bars').innerHTML = sser.map(function(x){
    return '<i style="height:' + Math.max(4, Math.round(x.t/mx*100)) + '%"></i>';
  }).join('');
  document.getElementById('sch-list').innerHTML = DB.schulte.slice(0,8).map(function(x){
    return '<div><span>' + x.d.slice(8,10) + '.' + x.d.slice(5,7) + '</span><b>' + x.t + ' с · ошибок ' + x.e + '</b></div>';
  }).join('') || '<div>Попыток пока нет.</div>';

  // профиль
  var dg = document.getElementById('diag');
  if (dg) dg.textContent = 'Версия 1.0 · Telegram SDK: ' + (TG ? 'подключён' : 'нет') +
    ' · хранилище: ' + (CS ? 'облако Telegram' : 'локальное на устройстве');
  if (DB.me.n) document.getElementById('m-name').value = DB.me.n;
  if (DB.me.tm) document.getElementById('m-team').value = DB.me.tm;
  if (DB.me.y) document.getElementById('m-year').value = DB.me.y;

  // подставить сегодняшние значения в шкалы
  if (wbToday){
    markScale('s-sleep', wbToday.s, 'sleep');
    markScale('s-quality', wbToday.q, 'quality');
    markScale('s-fatigue', wbToday.f, 'fatigue');
    markScale('s-mood', wbToday.m, 'mood');
    if (ok(wbToday.p)) document.getElementById('i-pulse').value = wbToday.p;
    if (ok(wbToday.w)) document.getElementById('i-weight').value = wbToday.w;
    if (wbToday.c) document.getElementById('i-note').value = wbToday.c;
  }
}
function markScale(id, val, key){
  if (val === null || val === undefined) return;
  pick[key] = val;
  var kids = document.getElementById(id).children;
  for (var i=0;i<kids.length;i++){
    var v = parseFloat(kids[i].textContent);
    kids[i].className = (v === val) ? 'on' : '';
  }
}
function esc(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

/* ---------- старт ---------- */
buildScale('s-sleep','sleep',5,11,0.5);
buildScale('s-quality','quality',1,5,1);
buildScale('s-fatigue','fatigue',1,10,1);
buildScale('s-mood','mood',1,10,1);
buildGrid(true);
boot();
</script>
